{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./backend/.env)",
      "Read(./**/*secret*)",
      "Read(./**/*credential*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(cat:*.env)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ]
  }
}
